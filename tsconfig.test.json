{
	"compilerOptions": {
		"target": "ES2022",
		"module": "commonjs",
		"moduleResolution": "node",
		"lib": ["ES2022", "ES2015", "DOM"],
		"outDir": "./dist-tsc",
		"rootDir": "./src",
		"sourceMap": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"ignoreDeprecations": "6.0"
	},
	"include": ["src/test/**/*"],
	"exclude": ["node_modules", "dist", "out", "src/webview"]
}
