# Dependencies
node_modules/

# Build output
dist/
dist-tsc/
out/
*.tsbuildinfo
coverage/

# Tool caches
.eslintcache

# VS Code extension package
*.vsix

# Reference extension folder and everything in it (regenerate with the
# upstream repo checkout; safe to delete at any time)
/reference/

# IDEs & AI coding harnesses — local agent/IDE state, ignored even when the
# harness is not currently used in this project
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.vscode-test/
.idea/
.zed/
.cursor/
.windsurf/
.claude/
.codex/
.gemini/
.qwen/
.opencode/
.amp/
.omp/
.crush/
.goose/
.cline/
.clinerules/
.roo/
.continue/
.serena/
.aider*
.kilocode/
.kilo/
.pi/
.pi-lens/
.freebuff/
.agents/

# Harness-local MCP config (paths/tokens for local servers; negate if you
# ever want to commit a shared one)
.mcp.json

# OpenSpec (generated)
.openspec/
openspec/

# Fallow output (generated)
.fallow/

# Graphify output (generated)
graphify-out/

# Logs
*.log

# Environment files
.env
.env.*
!.env.example
!.env.sample
!.env.*.example

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Local secrets / key material (slim safety net; the full packaging block
# lives in .vscodeignore)
*.pem
*.key
*.p12
*.pfx
