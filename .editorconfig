root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# Everything under src/webview is formatted by Prettier with 2 spaces
# (matches the [src/webview/**] override in .prettierrc.json).
[src/webview/**]
indent_style = space
indent_size = 2

[*.{svelte,yml,yaml,json,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
