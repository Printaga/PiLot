# ── Build / test output (only dist/ ships) ──
# Ship only the team-shared VS Code workspace files; everything else in .vscode stays out.
.vscode/**
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode-test/**
out/**
dist-tsc/**
dist/webview/assets/*.map
src/**

# ── Dependencies (bundled via esbuild; PI runtime resolves from user install) ──
node_modules/**
**/node_modules/**

# ── VCS / agent tool caches ──
# Missing entries here pack tens of thousands of files into the VSIX.
# .freebuff worktrees also contain symlinked node_modules that crash
# the packager (yazl "not a file" error).
.git/**
**/.git/**
.freebuff/**
**/.freebuff/**
.fallow/**
**/.fallow/**
.pi/**
**/.pi/**
.pi-lens/**
**/.pi-lens/**
.kilo/**
**/.kilo/**
.kilocode/**
**/.kilocode/**
.claude/**
**/.claude/**
.agents/**
**/.agents/**
.omp/**
**/.omp/**
openspec/**
**/openspec/**
graphify-out/**
/fallow-baselines/
/reference/

# ── Extension scaffolding / hooks (dev-only) ──
.husky/**
.github/**
.vscodeignore
.gitignore
.gitattributes
.mcp.json
.editorconfig
.lintstagedrc.json
.prettierignore
.prettierrc.json
.fallowrc.json

# ── Dev-only root docs / scripts ──
AGENTS.md
TODO.md
IMPLEMENTATION_PLAN.md
skill-management-gui.md
dl-tmp.mjs
run-clean.mjs

# ── Toolchain configs ──
eslint.config.mjs
svelte.config.js
tsconfig.json
tsconfig.test.json
tsconfig.webview.json
vite.webview.config.mts
esbuild.config.mjs
pnpm-lock.yaml
pnpm-workspace.yaml

# ── Dev-only dirs (postinstall/verify scripts, patches) ──
patches/**
scripts/**

# ── Media: ship runtime assets only ──
# Needed at runtime: icon.*, kofi.png (sidebar link), voice/ (dictation helpers).
media/**
!media/icon.png
!media/icon.svg
!media/kofi.png
!media/voice
!media/voice/**
media/kofi.webp
media/screenshot.png
# macOS .framework bundles are symlink farms (Versions/Current -> A plus
# top-level Headers/Resources/Libraries/whisper links). Re-adding them verbatim
# either trips the yazl "not a file" packager error or gets silently dropped,
# which breaks @rpath/.../Versions/Current/whisper for the darwin voice helper.
# Ship only the real (non-link) payload under Versions/A and Versions/Current.
media/voice/whisper.framework/Versions/A/whisper
media/voice/whisper.framework/Versions/A/Resources/Info.plist
media/voice/whisper.framework/Versions/Current/whisper
media/voice/whisper.framework/Versions/Current/Resources/Info.plist

# ── Misc ──
*.vsix
*.log
.DS_Store
# Environment/secret files at ANY depth (root .env entries above don't cover
# nested ones like .claude/.env or media/.env.local).
.env
.env.*
**/.env
**/.env.*
*.pem
*.key
**/*.pem
**/*.key
credentials*.json
**/credentials*.json
*credentials*.json
**/*credentials*.json
secrets*.json
**/secrets*.json
*-service-account*.json
**/*-service-account*.json
*.p12
**/*.p12
*.pfx
**/*.pfx
*.jks
**/*.jks
*.keystore
**/*.keystore
*.crt
**/*.crt
id_rsa*
**/id_rsa*
id_ed25519*
**/id_ed25519*
.npmrc
**/.npmrc
.netrc
**/.netrc
*.pypirc
**/*.pypirc
**/*.ts.map
**/tsconfig.json
**/tslint.json
